# Copy to .env and change every "change-me" value.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=soivi
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=soivi
POSTGRES_PORT=5433
# Used by tools running on the host (make test, alembic outside Docker).
# Inside docker compose this is overridden to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg://soivi:change-me-postgres@localhost:5433/soivi

# --- MinIO (snapshot storage) ---
MINIO_ROOT_USER=soivi
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3 client settings used by the app. Inside docker compose S3_ENDPOINT is overridden to minio:9000.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=soivi
S3_SECRET_KEY=change-me-minio
S3_BUCKET=snapshots
S3_SECURE=false

# --- Crawling (be polite) ---
# Must name the project and give a real contact address.
CRAWLER_USER_AGENT=SoiviBot/0.1 (+mailto:contact@example.com)
# Minimum seconds between requests to the same domain. Cannot be below 5.
CRAWLER_MIN_DELAY_SECONDS=5

# --- Anthropic (structured extraction, ambiguous news items) ---
# Empty key: the LLM is off and ambiguous news items wait, unclassified.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort for card extraction (low|medium|high|xhigh|max).
CARD_EXTRACTION_EFFORT=high

# Review app login (HTTP basic auth). Use a long random password.
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD=change-me-review
REVIEW_PORT=8001

# Telegram alerts (daily summary + broken adapters). Empty token = print instead.
# Create a bot with @BotFather; get the chat id by messaging the bot and opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_SUMMARY_HOUR=19

# --- Public API ---
API_CACHE_SECONDS=60
REPORT_RATE_LIMIT_PER_HOUR=5
# Captcha for POST /reports: empty (off), turnstile or hcaptcha, plus its secret key.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=
TRUST_PROXY_HEADERS=false

# --- Public site (web/) ---
# The review app POSTs here after approvals; the site checks the shared secret.
SITE_REVALIDATE_URL=http://web:3000/api/revalidate
SITE_REVALIDATE_SECRET=change-me-long-random
# Server-side base URL the site uses to read the API.
SOIVI_API_URL=http://api:8002
# Public address of the site (canonical URLs, sitemap, Open Graph).
SITE_URL=http://127.0.0.1:3000
# Optional Cloudflare Turnstile site key for the report form (pairs with CAPTCHA_SECRET).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
